    "seed:questions": "node src/database/seeds/quizzes.js",
    "seed:quizzes": "node src/database/seeds/quizzes.js",
    "dev": "nodemon src/server.js",
    "dev:worker": "nodemon --signal SIGTERM src/workers/index.js",
    "dev:all": "concurrently --kill-others --names API,WORKER \"npm run dev\" \"npm run dev:worker\"",
    "postinstall": "puppeteer browsers install chrome",
    "migrate": "node-pg-migrate --migrations-dir src/database/migrations",
    "migrate:deploy": "node-pg-migrate up --migrations-dir src/database/migrations --advisory-lock-mode wait",
